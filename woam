def epoch_of(ts: str) -> float:
    """Our ISO-Z timestamp back to epoch seconds. 0.0 on anything unparseable, which makes
    a caller search the whole log rather than silently search none of it."""
    try:
        import calendar
        return float(calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ")))
    except Exception:
        return 0.0


def classify_dirty(dirty: dict):
    """Split changed groups by WHO changed them, using kernel evidence.

    This is the whole point of the audit layer. Before it, every change on the box was
    reported to the agent as its own, so a log rotation or an unattended-upgrade read as
    "you changed this and did not say why" - and the agent either recorded a fiction or
    learned to ignore the tool.

    Conservative on purpose. Only a group whose every recorded write came from OUTSIDE a
    login session is moved to `system`. "Watched but no event" stays with the agent,
    because a change predating the watch, or a rotated log, is not evidence that the OS
    did it, and inventing that would be the same fabrication in the other direction.
    """
    agent, system = {}, {}
    for name, d in dirty.items():
        paths = []
        for _sname, dd in (d.get("named") or {}).items():
            for kind in ("modified", "created", "removed"):
                paths.extend(dd.get(kind) or [])
        verdict, actors, _ev = attribution_for(paths, epoch_of(d.get("since", "")))
        d["verdict"], d["actors"] = verdict, actors
        (system if verdict == "system" else agent)[name] = d
    return agent, system


def cmd_status(argv) -> int:
    dirty = dirty_groups()
    entries = read_log()
    print(BANNER)
    print()
    print(f"machine  {os.uname().nodename}    groups {len(GROUPS)}    records {len(entries)}")
    base = load_baseline()
    blind = {}
    for g, gi in base.items():
        for sname, r in (gi.get("subs") or {}).items():
            if r.get("blind"):
                blind[f"{g}/{sname}"] = r["blind"]
    if blind:
        # "clean" must never silently mean "I could not look".
        print(f"\n  NOT FULLY VISIBLE (run as root for a complete picture):")
        for n, paths in blind.items():
            print(f"    {n:9s} could not read {len(paths)} path(s), e.g. {paths[0]}")

    closed = {e.get("id") for e in entries if e.get("ev") == "gap_closed"}
    gaps = [e for e in entries if e.get("ev") == "gap" and e.get("id") not in closed]
    if gaps:
        print(f"\n  {len(gaps)} unexplained change(s):  woam gaps")

    audit_ok, audit_why = audit_available()
    agent_dirty, system_dirty = classify_dirty(dirty)

    if system_dirty:
        # NOT the agent's problem, and saying so is the point. Every one of these would
        # previously have been reported as "you changed this and did not say why".
        print("\n  THE SYSTEM DID THESE - no record needed, no login session behind them:\n")
        for name, d in system_dirty.items():
            subs = ", ".join(f"{sn}({fc})" for sn, fc in d["subs"]) or "?"
            print(f"    {name:9s} {subs}   (auid unset on every recorded write)")

    if agent_dirty:
        print("\n  UNRECORDED CHANGES - these groups changed and nothing says why:\n")
        for name, d in agent_dirty.items():
            subs = ", ".join(f"{sn}({fc})" for sn, fc in d["subs"]) or "?"
            print(f"    {name:9s} {subs}   since {d['since']}")
            # Who, on the kernel's evidence rather than ours.
            v, actors = d.get("verdict"), d.get("actors") or []
            if v == "agent":
                print(f"    {'':9s}   BY   {', '.join(actors)}")
            elif v == "none":
                print(f"    {'':9s}   BY   unrecorded - the change predates the watch, or the log rotated")
            elif v == "unwatched":
                print(f"    {'':9s}   BY   UNKNOWN - these paths are not watched, so nothing can be concluded")
            elif v == "no-audit":
                print(f"    {'':9s}   BY   UNKNOWN - attribution is off on this machine")
            for sname, dd in (d.get("named") or {}).items():
                for kind in ("modified", "created", "removed"):
                    for f in dd[kind][:4]:
                        print(f"    {'':9s}   {kind[:3]}  {f}")
                    extra = len(dd[kind]) - 4
                    if extra > 0:
                        print(f"    {'':9s}   {'':3s}  ... and {extra} more {kind}")
                for kd in (dd.get("keys") or [])[:6]:
                    print(f"    {'':9s}   KEY  {kd}")
                for u in (dd.get("unreadable") or [])[:3]:
                    print(f"    {'':9s}   ??   {u}  (seen before, UNREADABLE now - not deleted)")
            print(f"    {'':9s} record it:  woam note {name} \"what you did and why\"")
            print(f"    {'':9s} or defer:   woam note {name} --defer \"reason unknown\"")
        if not audit_ok:
            # The one thing that must never be quiet: a report that looks like attribution
            # but is not one.
            print(f"\n  ⚠ ATTRIBUTION IS OFF ({audit_why}).")
            print("  These groups CHANGED; who changed them is not known, and some of it may")
            print("  be the operating system's own work. Turn it on:  woam audit-install")
        print("\n  Writing costs a few tokens. Not writing costs the next agent thousands,")
        print("  or worse, sends it down a path that does not work here.")
        return 1                       # non-zero: `woam status && deploy` stops
    if not load_baseline():
        # A fresh install has nothing to compare against. Reporting "all clean"
        # here would be the confidently-wrong failure this tool exists to prevent.
        print("\n  NO BASELINE on this machine - nothing has been recorded to compare against.")
        print("  This is not 'clean'. It means woam cannot yet tell you what changed.")
        print("    take one:  woam baseline")
        return 1
    print("\n  all groups recorded")
    return 0


def cmd_show(argv) -> int:
    name = argv[0] if argv else None
    if name and name not in GROUPS:
        print(f"unknown group '{name}'. known: {', '.join(GROUPS)}", file=sys.stderr)
        return 2
    names = [name] if name else list(GROUPS)
    entries = read_log()
    for g in names:
        info = GROUPS[g]
        print(f"\n=== {g} - {info['what']} ===")
        recs = [e for e in entries if e.get("group") == g][-5:]
        if recs:
            print("  recorded:")
            for e in recs:
                mark = "?" if e.get("deferred") else "-"
                print(f"    {mark} {e['ts']}  {e.get('why', '')[:90]}")
                # `what` is the machine-derived list of what changed; `files` is a
                # COUNT. Subscripting the count threw TypeError and took the whole
                # command down, on the exact path that matters: a note recorded
                # against a group that had actually changed. On a clean group
                # `files` is None, so every manual test passed. Caught by
                # test/smoke.sh, which notes against a group it made dirty first.
                for w in (e.get("what") or [])[:3]:
                    print(f"        {w}")
                n = e.get("files")
                if isinstance(n, int) and n > 3:
                    print(f"        ... and {n - 3} more file(s) changed")
        else:
            # Honest emptiness. A confident wrong answer kills trust in one shot;
            # an honest blank keeps the habit alive.
            print("  recorded: nothing yet for this group")
        if info["probe"]:
            print("  check current state (these are commands, not stored answers):")
            for label, cmd in info["probe"]:
                print(f"    {label:11s} {cmd}")
    return 0


def cmd_note(argv) -> int:
    if not argv:
        print("usage: woam note <group> \"what you did and why\" [--defer]", file=sys.stderr)
        return 2
    group, rest = argv[0], argv[1:]
    if group not in GROUPS:
        print(f"unknown group '{group}'. known: {', '.join(GROUPS)}", file=sys.stderr)
        return 2
    deferred = "--defer" in rest
    why = " ".join(a for a in rest if a != "--defer").strip()
    if not why:
        print("say what you did. one line is enough.", file=sys.stderr)
        return 2

    d = dirty_groups().get(group, {})
    # The WHAT is machine-derived; the agent supplies only the WHY. Capped so the
    # record stays one line under PIPE_BUF and the append stays atomic.
    what = []
    for sname, dd in (d.get("named") or {}).items():
        for kind in ("modified", "created", "removed"):
            for f in dd[kind][:5]:
                what.append(f"{kind[:3]}:{sname}:{f}")
        for kd in (dd.get("keys") or [])[:8]:
            what.append(f"key:{sname}:{kd}")
    append({"ev": "note", "group": group, "why": why, "by": actor(),
            "deferred": deferred, "subs": [sn for sn, _ in d.get("subs", [])],
            "what": what[:20], "files": d.get("files")})
    rebaseline([group])
    print(f"recorded against {group}" + ("  (deferred: no cause given)" if deferred else ""))
    return 0


def session_file(sid: str) -> Path:
    safe = "".join(c for c in str(sid) if c.isalnum() or c in "-_")[:64] or "unknown"
    return SESSIONS / f"{safe}.json"


def cmd_session_open(argv) -> int:
    """Snapshot state at the START of a session, so the seal at the end reports ONLY
    what changed WHILE THIS AGENT WAS LOGGED IN.

    Without this, woam diffs against a baseline taken long ago and reports every
    change the OS made since - log rotation, unattended-upgrades, cron, package
    state - as though the agent had done it. On 2026-08-05 that produced a claim
    that /root/.ssh/authorized_keys and two /etc/sudoers.d files had been DELETED.
    Nothing had touched them and no agent was involved.

    An agent memory must record what the AGENT did. Other actors on the box are not
    its business, and attributing their work to it is a lie that costs a session.
    """
    sid = argv[0] if argv else os.environ.get("WOAM_SESSION") or str(os.getpid())
    snap = {}
    for name in GROUPS:
        try:
            snap[name] = hash_group(name)
        except Exception:
            continue
    SESSIONS.mkdir(parents=True, exist_ok=True)
    f = session_file(sid)
    tmp = f.with_suffix(".tmp")
    tmp.write_text(json.dumps({"ts": now(), "by": actor(), "groups": snap}))
    os.replace(tmp, f)
    print(f"session {sid} opened")
    return 0


def cmd_seal(argv) -> int:
    """Record what changed when NOBODY explained it. The abandoned-session case.

    This is the half that matters most and the half an agent will never do
    voluntarily: the LAST write, at the moment the work is finished, when the
    agent has no remaining stake. So it must not depend on the agent at all -
    the WHAT is machine-derived and the WHY is recorded as explicitly MISSING,
    with an id so it can be closed later by whoever works it out.

    An honest "nobody said why" beats both silence and a fabricated reason: the
    next agent learns the state changed AND that the reasoning is unknown, so it
    verifies instead of trusting.
    """
    sid = None
    if "--session" in argv:
        i = argv.index("--session")
        sid = argv[i + 1] if i + 1 < len(argv) else None
    sid = sid or os.environ.get("WOAM_SESSION")
    prev = None
    if sid:
        try:
            prev = json.loads(session_file(sid).read_text()).get("groups")
        except Exception:
            prev = None            # no snapshot: fall back, but say so
    dirty = dirty_groups(prev)
    if not dirty:
        print("nothing unrecorded" + (f" for session {sid}" if sid else ""))
        if sid:
            try: session_file(sid).unlink()
            except Exception: pass
        return 0
    # Attribution BEFORE sealing. Groups the OS changed are not gaps: nobody owes an
    # explanation for log rotation or an unattended upgrade, and asking for one is how a
    # record gets fabricated to make the tool shut up.
    agent_dirty, system_dirty = classify_dirty(dirty)
    if system_dirty:
        print(f"  skipped {len(system_dirty)} group(s) the SYSTEM changed: "
              + ", ".join(system_dirty) + " (no login session behind them)")
    if not agent_dirty:
        print("nothing unrecorded that a login session is responsible for")
        rebaseline(list(dirty))
        if sid:
            try: session_file(sid).unlink()
            except Exception: pass
        return 0

    sealed = 0
    for group, d in agent_dirty.items():
        what = []
        for sname, dd in (d.get("named") or {}).items():
            for kind in ("modified", "created", "removed"):
                for f in dd[kind][:5]:
                    what.append(f"{kind[:3]}:{sname}:{f}")
            for kd in (dd.get("keys") or [])[:8]:
                what.append(f"key:{sname}:{kd}")
        gid = hashlib.sha256(f"{group}{now()}{d.get('files')}".encode()).hexdigest()[:6]
        # `by` is the AUDITED writer, not whoever ran seal. Under the PAM hook seal runs as
        # root with no SSH_CLIENT, which is exactly how the earlier version recorded
        # `by=unknown@plausible` for a write it had complete information about.
        by = ", ".join(d.get("actors") or []) or actor()
        append({"ev": "gap", "id": gid, "group": group, "by": by,
                "by_evidence": d.get("verdict"), "sealed_by": actor(),
                "subs": [sn for sn, _ in d.get("subs", [])], "what": what[:20],
                "files": d.get("files"), "why": None, "closed": False})
        print(f"  {gid}  {group}: {d.get('files')} file(s) changed, WHY NOT RECORDED")
        print(f"          by {by}" + ("" if d.get("verdict") == "agent" else
                                      f"  (attribution: {d.get('verdict')})"))
        for w in what[:4]:
            print(f"          {w}")
        sealed += 1
    rebaseline(list(dirty))
    if sid:
        try: session_file(sid).unlink()
        except Exception: pass
    print(f"\nsealed {sealed} group(s) with the reason marked MISSING.")
    print("Close one when you work it out:  woam why <id> \"...\"")
    return 0


def cmd_why(argv) -> int:
    """Close a gap after the fact. Records WHEN it was explained as well as when
    it happened, so the record stays honest about how the knowledge was acquired."""
    if len(argv) < 2:
        print("usage: woam why <id> \"what actually happened\"   (or --unknown \"...\")", file=sys.stderr)
        return 2
    gid, rest = argv[0], argv[1:]
    unknown = "--unknown" in rest
    why = " ".join(a for a in rest if a != "--unknown").strip()
    if not why:
        print("say something, even if it is that the cause is not established.", file=sys.stderr)
        return 2
    target = None
    for e in read_log():
        if e.get("ev") == "gap" and e.get("id") == gid:
            target = e
    if not target:
        print(f"no open gap with id '{gid}'. list them:  woam gaps", file=sys.stderr)
        return 2
    append({"ev": "gap_closed", "id": gid, "group": target.get("group"),
            "why": why, "unknown": unknown, "by": actor(),
            "happened_at": target.get("ts")})
    print(f"closed {gid}" + ("  (cause NOT established - recorded as unknown)" if unknown else ""))
    return 0


def cmd_fix(argv) -> int:
    """Correcting a wrong entry is the reader's job. Nothing here is guaranteed
    correct; it is guaranteed honest. A correction is a new record, never an
    edit - the log is append-only and history is not rewritten."""
    if len(argv) < 2:
        print("usage: woam fix <group> \"what is actually true\"", file=sys.stderr)
        return 2
    group, why = argv[0], " ".join(argv[1:]).strip()
    if group not in GROUPS:
        print(f"unknown group '{group}'. known: {', '.join(GROUPS)}", file=sys.stderr)
        return 2
    append({"ev": "fix", "group": group, "why": why, "by": actor()})
    print(f"correction recorded against {group}")
    return 0


def cmd_gaps(argv) -> int:
