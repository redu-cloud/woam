def all_subs():
    for g, gi in GROUPS.items():
        for sname, si in gi["subs"].items():
            yield g, sname, si


def group_for(path: str) -> str:
    """Map a path to exactly one group/sub. Longest prefix wins; unmatched -> host/other."""
    p = os.path.abspath(path)
    best, best_len = "host/other", -1
    for g, sname, si in all_subs():
        for root in si["paths"]:
            root = root.replace("/*/", "/")          # glob roots compare on their literal stem
            if (p == root or p.startswith(root.rstrip("/") + "/")) and len(root) > best_len:
                best, best_len = f"{g}/{sname}", len(root)
    return best


def sh(cmd: str, timeout: int = 8) -> str:
    try:
        r = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, timeout=timeout)
        return (r.stdout or "").strip()
    except Exception:
        return ""


def now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def actor() -> str:
    """Best-effort identity. Never fabricates: unknown stays unknown.

    The kernel answer comes FIRST. /proc/self/loginuid is the login uid, set by PAM at
    session open, and it survives sudo and su: a process running as root still carries the
    uid of whoever logged in. Environment variables cannot do this. SSH_CLIENT is absent
    when PAM runs a hook as root - which is exactly how the earlier PAM integration recorded
    `by=unknown@plausible` for a write it had complete information about.
    """
    auid, ses = self_login()
    if auid is not None and auid != AUID_UNSET:
        return f"{uid_name(auid)}(auid={auid},ses={ses if ses is not None else '?'})"
    for env in ("WOAM_ACTOR", "CLAUDE_SESSION_ID", "SSH_CLIENT"):
        v = os.environ.get(env)
        if v:
            return v.split()[0][:64]
    return f"{os.environ.get('USER', 'unknown')}@{os.uname().nodename}"


def claimed_actor():
    """What the caller SAYS it is. Recorded alongside the kernel's answer, never instead
    of it.

    Both are worth having and they are not the same kind of fact. The kernel knows the
    login session; it cannot know that three different agents shared it, and a session id
    is genuinely useful for finding the transcript later. But an identity the subject
    supplies about itself is a claim, not evidence, and letting it overwrite `by` would
    mean anything with an env var could sign a record as somebody else. So it lands in its
    own field, named for what it is.
    """
    for env in ("WOAM_ACTOR", "CLAUDE_SESSION_ID"):
        v = os.environ.get(env)
        if v:
            return v.split()[0][:64]
    return None


# ---------------------------------------------------------------------------
# ATTRIBUTION. Who wrote a file, on the kernel's authority rather than ours.
#
# The diff engine below compares two points in time and INFERS. It has no evidence of
# who did anything, so it is structurally incapable of attribution, and every
# misattribution woam has ever produced traces to that. It once reported
# /root/.ssh/authorized_keys and two /etc/sudoers.d files as DELETED when nothing had
# touched them: a fabricated security event.
#
# The kernel already records the truth. One audit watch produces, for a real write:
#
#   type=SYSCALL ... auid=1000 uid=0 ses=214 comm="sed" exe="/usr/bin/sed" key="woam"
#   type=PATH    ... name="/etc/redu-app/app.env" nametype=NORMAL
#
#   * auid is the LOGIN uid and SURVIVES SUDO. The process above ran as uid=0; auid is
#     still the person who logged in. Nothing in userspace can reconstruct that.
#   * ses is the PAM session id: which login did this, exactly.
#   * auid=4294967295 (unset) means NO LOGIN SESSION is behind the write. Measured: an
#     agent's write records auid=1000; a systemd unit's records the sentinel.
#
# So `auid != AUID_UNSET` is precisely "a person or an agent did this, not the OS". That
# is the whole requirement, answered by a field the kernel fills in for free.
#
# WHY THE RAW LOG AND NOT `ausearch`
#     Measured on a live VM, auditd 3.1.2: records land in /var/log/audit/audit.log within
#     one second, and `ausearch -k woam` reports "<no matches>" for those same records
#     FOREVER, while `ausearch --input /var/log/audit/audit.log -k woam` finds them. Its
#     default input resolution cannot be relied on. Shelling to it would have made woam
#     report "no agent activity" on every machine, silently, which is the exact
#     confidently-wrong failure this tool exists to prevent. The log format is stable and
#     documented; parsing it costs less than depending on that behaviour.
# ---------------------------------------------------------------------------
AUID_UNSET = 4294967295          # kernel sentinel for "no login session behind this"
AUDIT_KEY = "woam"
AUDIT_LOG = Path(os.environ.get("WOAM_AUDIT_LOG", "/var/log/audit/audit.log"))
AUDIT_RULES = Path(os.environ.get("WOAM_AUDIT_RULES", "/etc/audit/rules.d/woam.rules"))


def self_login():
    """(auid, ses) of THIS process, straight from the kernel. (None, None) if unavailable
    (a kernel without audit support, or a container that does not expose it)."""
    def rd(p):
        try:
            v = int(Path(p).read_text().strip())
            return v
        except Exception:
            return None
    return rd("/proc/self/loginuid"), rd("/proc/self/sessionid")


def uid_name(uid: int) -> str:
    """Resolve a uid to a name without pwd lookups failing the tool."""
    try:
        import pwd
        return pwd.getpwuid(uid).pw_name
    except Exception:
        return str(uid)


_AUDIT_HEAD = re.compile(r"^type=(?P<t>\w+) msg=audit\((?P<ts>\d+(?:\.\d+)?):(?P<serial>\d+)\):\s*(?P<rest>.*)$")


def _qfield(rest: str, name: str):
    """A quoted audit field: comm="sed". Returns None if absent."""
    m = re.search(r'\b%s="([^"]*)"' % re.escape(name), rest)
    return m.group(1) if m else None


def _nfield(rest: str, name: str):
    """A numeric audit field: auid=1000. Returns None if absent or not a number."""
    m = re.search(r"\b%s=(-?\d+)\b" % re.escape(name), rest)
    return int(m.group(1)) if m else None


def audit_available():
    """(ok, reason). NEVER raises, and never answers "fine" when it does not know."""
    if not AUDIT_LOG.exists():
        return False, f"no audit log at {AUDIT_LOG} (auditd not installed?)"
    if not os.access(str(AUDIT_LOG), os.R_OK):
        return False, f"{AUDIT_LOG} is not readable by this user (run as root)"
    return True, ""


def audit_watched_paths():
    """The paths woam has asked the kernel to watch, from OUR rules file.

    This matters more than it looks. Absence of an audit event only means "the OS did it"
    for a path that is actually WATCHED. For an unwatched path, absence means we do not
    know - and reporting that as "the system did it" would be a fabrication of exactly the
    kind this layer exists to end.
    """
    out = []
    try:
        for line in AUDIT_RULES.read_text().splitlines():
            m = re.match(r"\s*-w\s+(\S+)", line)
            if m:
                out.append(m.group(1).rstrip("/"))
    except Exception:
        pass
    return out


def audit_writes(since_epoch: float = 0.0, key: str = AUDIT_KEY, limit: int = 4000):
    """Write events carrying `key`, correlated SYSCALL+PATH, newest last.

    Returns [{ts, serial, auid, ses, comm, exe, success, paths:[...] , system:bool}].
    `system` is True when auid is the unset sentinel, i.e. no login session was behind it.
    Never raises: an unreadable or malformed log yields [] and audit_available() explains.
    """
    ok, _ = audit_available()
    if not ok:
        return []
    events, order = {}, []
    try:
        with AUDIT_LOG.open("r", errors="replace") as fh:
            for line in fh:
                m = _AUDIT_HEAD.match(line)
                if not m:
                    continue
                ts = float(m.group("ts"))
                if ts < since_epoch:
                    continue
                serial, typ, rest = m.group("serial"), m.group("t"), m.group("rest")
                if typ == "SYSCALL":
                    if _qfield(rest, "key") != key:
                        continue
                    auid = _nfield(rest, "auid")
                    if serial not in events:
                        order.append(serial)
                    events[serial] = {
                        "ts": ts, "serial": serial,
                        "auid": auid, "ses": _nfield(rest, "ses"),
                        "comm": _qfield(rest, "comm"), "exe": _qfield(rest, "exe"),
                        "success": _qfield(rest, "success") or
                                   (re.search(r"\bsuccess=(\w+)", rest).group(1)
                                    if re.search(r"\bsuccess=(\w+)", rest) else None),
                        "paths": [],
                        # The single load-bearing classification in this file.
                        "system": auid is None or auid == AUID_UNSET or auid < 0,
                    }
                elif typ == "PATH" and serial in events:
                    # nametype=PARENT names the containing directory, not the thing that
                    # changed. Recording it would attribute a write to /etc rather than to
                    # the file, which reads as a far bigger event than it was.
                    if re.search(r"\bnametype=PARENT\b", rest):
                        continue
                    nm = _qfield(rest, "name")
                    if nm and nm not in events[serial]["paths"]:
                        events[serial]["paths"].append(nm)
    except Exception:
        return []
    return [events[s] for s in order[-limit:]]


def attribution_for(paths, since_epoch: float = 0.0):
    """Who touched these paths, as evidence rather than inference.

    Returns (verdict, actors, events) where verdict is one of:
        "agent"    - at least one write from a real login session
        "system"   - writes exist, all from OUTSIDE any login session (the OS did it)
        "none"     - the paths are watched and no write was recorded at all
        "unwatched"- not covered by a woam audit rule, so nothing can be concluded
        "no-audit" - auditd unavailable; this layer has nothing to say
    """
    ok, _ = audit_available()
    if not ok:
        return "no-audit", [], []
    watched = audit_watched_paths()
    if not watched:
        return "unwatched", [], []

    def covered(p):
        p = str(p)
        return any(p == w or p.startswith(w + "/") for w in watched)

    if not any(covered(p) for p in paths):
        return "unwatched", [], []

    wanted = {str(p) for p in paths}
    hits = [e for e in audit_writes(since_epoch)
            if any(p in wanted for p in e["paths"])]
    if not hits:
        return "none", [], []
    human = [e for e in hits if not e["system"]]
    if not human:
        return "system", [], hits
    actors = sorted({f"{uid_name(e['auid'])}(auid={e['auid']},ses={e['ses']})" for e in human})
    return "agent", actors, human


def audit_rules_text() -> str:
    """The auditctl rules for every group path, GENERATED FROM GROUPS.

    Generated, never hand-written, so the watches and the groups cannot drift apart. A
    group whose path is not watched would report "the system did it" for every agent write
    to it, which is worse than reporting nothing.

    Narrow by construction: one watch per configured path, `-p wa` (write + attribute), and
    never `-w /`. Watch breadth is what audit overhead is proportional to.
    """
    lines = [
        "# GENERATED by `woam audit-rules`. Do not edit; edit the GROUPS table in woam.",
        "# -p wa = write + attribute change. Narrow watches only: never -w /.",
    ]
    seen = set()
    audit_source = os.environ.get("WOAM_AUDIT_APP_SOURCE") == "1"
    for _g, sname, si in all_subs():
        if si.get("audit") is False and not (sname == "source" and audit_source):
            continue                       # bulk trees: see the note in GROUPS
        for p in si["paths"]:
            if "*" in p:
                # auditctl has no globs, and truncating at the '*' is how
                # /home/*/.ssh/authorized_keys became `-w /home`: a recursive watch on
                # every home directory, which is exactly where agents clone repos and
                # build. Expand to the files that actually exist instead. A home created
                # later is simply not watched, which `woam who` reports as "unwatched"
                # rather than pretending to know.
                for real in sorted(glob.glob(p)):
                    if real not in seen:
                        seen.add(real)
                        lines.append(f"-w {real} -p wa -k {AUDIT_KEY}")
                continue
            if not p or p in seen:
                continue
            seen.add(p)
            lines.append(f"-w {p} -p wa -k {AUDIT_KEY}")
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# The log. One JSON object per line. RFC 8259 forbids a literal newline inside a
# string, so the record delimiter cannot occur inside a record: the one-line
# invariant is enforced by the grammar, not by convention.
# ---------------------------------------------------------------------------
def append(rec: dict) -> None:
    rec = {"ts": now(), "v": VERSION, **rec}
    # A self-declared label, kept separate from `by` so a claim can never pass for evidence.
    claim = claimed_actor()
    if claim and "claims" not in rec:
        rec["claims"] = claim
    line = json.dumps(rec, separators=(",", ":"), ensure_ascii=False)
    if len(line.encode()) > 3900:  # stay under PIPE_BUF so O_APPEND is atomic
        rec["why"] = (rec.get("why") or "")[:600] + " ...(truncated)"
        line = json.dumps(rec, separators=(",", ":"), ensure_ascii=False)
    ROOT.mkdir(parents=True, exist_ok=True)
    # O_APPEND + a single write() is the atomic path. Never open("a") then print().
    fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, (line + "\n").encode())
    finally:
        os.close(fd)


def read_log() -> list:
    if not LOG.exists():
        return []
    out = []
    for line in LOG.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except Exception:
            # A torn final record costs one entry, never the file. This is the
            # whole reason the log is JSONL and not a JSON array or YAML.
            continue
    return out


# ---------------------------------------------------------------------------
# Dirty detection. Hash the group's paths and compare to the recorded baseline.
# No daemon: nothing to die, no privileges, works identically on a laptop.
# ---------------------------------------------------------------------------
# Directories that are large, machine-generated, and never the thing an agent
# meant to change. Walking them is what made the first version unusable.
PRUNE = {".git", "node_modules", "__pycache__", ".cache", ".venv", "venv",
         "site-packages", ".next", "dist", "build", ".terraform", "vendor"}
MAX_FILES = 4000       # per group; recorded when hit so the cap is never silent


def _walk(root: Path, budget: int, blind=None):
    """Yield files under root, pruning generated trees. Iterative: a deep tree
    must not blow the stack, and a symlink loop must not hang."""
    if root.is_file():
        yield root
        return
    seen = set()
    stack = [root]
    while stack and budget > 0:
        d = stack.pop()
        try:
            real = d.resolve()
            if real in seen:          # symlink loop
                continue
            seen.add(real)
            with os.scandir(d) as it:
                for e in it:
                    if budget <= 0:
                        return
                    try:
                        if e.is_symlink():
                            continue
                        if e.is_dir():
                            if e.name not in PRUNE and not e.name.startswith("."):
                                stack.append(Path(e.path))
                        elif e.is_file():
                            budget -= 1
                            yield Path(e.path)
                    except OSError:
                        continue
        except (PermissionError, OSError):
            # A directory we cannot descend is UNKNOWN, not empty. Swallowing this
            # silently is what made woam report existing files as "removed".
            if blind is not None:
                blind.append(str(d))
            continue


KEY_RE = None   # compiled lazily; stdlib re imported at use site to keep startup cheap


def key_digest(path: Path) -> dict:
    """For KEY=VALUE config, record each key name -> a HASH of its value.

    Names only, values never stored: this is the most-read file on the box and it
    must never become where secrets leak. The hash is enough to say "this key
    changed" without ever knowing what it changed to.

    Live incident 2026-08-05 is why this exists: woam correctly named the .env as
    the changed file, and an agent still had to open it and eyeball 20 keys to find
    the one that mattered.
    """
    import re
    global KEY_RE
    if KEY_RE is None:
        KEY_RE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.]*)\s*=(.*)$")
    out = {}
    try:
        if path.stat().st_size > 262144:      # not a config file; do not parse it
            return {}
        for line in path.read_text(errors="replace").splitlines():
            m = KEY_RE.match(line)
            if m:
                out[m.group(1)] = hashlib.sha256(m.group(2).strip().encode()).hexdigest()[:8]
    except Exception:
        return {}
    return out


def hash_sub(paths, budget, keys=False) -> dict:
    """Digest one subgroup. METADATA only (path/size/mtime/mode).

    Deliberately not content: reading every file took minutes on a real machine,
    and a tool that slow is a tool nobody runs. Every case that matters here -
    edit, rename, resize, replace, chmod - moves one of these fields.

    Never raises. Anything unreadable is REPORTED, never silently skipped: a
    "clean" that actually meant "I could not look" is the confidently-wrong
    failure this whole tool exists to prevent.
    """
    h = hashlib.sha256()
    n, capped, blind = 0, False, []
    # Per-file metadata so a record can NAME the files. The agent should never have
    # to author the WHAT - only the WHY. Cheap: ~100 bytes/file, ~80KB on a real VM.
    files = {}
    kmap = {}
    for pattern in sorted(paths):
        try:
            roots = [Path(x) for x in glob.glob(pattern)] if "*" in pattern else [Path(pattern)]
        except Exception:
            blind.append(pattern); continue
        for p in roots:
            try:
                if not p.exists():
                    continue
            except Exception:
                blind.append(str(p)); continue
            try:
                for f in _walk(p, budget - n, blind):
                    try:
                        st = f.stat()
                    except Exception:
                        blind.append(str(f)); continue
                    sig = f"{st.st_size}:{int(st.st_mtime)}:{st.st_mode}"
                    h.update(f"{f}:{sig}\n".encode())
                    files[str(f)] = sig
                    if keys:
                        k = key_digest(f)
                        if k:
                            kmap[str(f)] = k
                    n += 1
                    if n >= budget:
                        capped = True
                        break
            except Exception:
                blind.append(str(p)); continue
    return {"hash": h.hexdigest()[:16], "files": n, "capped": capped,
            "blind": blind[:5], "f": files, "k": kmap}


def diff_files(before: dict, after: dict, blind=None) -> dict:
    """Exact filenames, split by how they changed.

    CRITICAL: a file we could not READ this pass is UNKNOWN, never "removed".
    Found 2026-08-05 by an agent fixing a real incident: baselined as root, then run
    as an unprivileged user, woam reported /root/.ssh/authorized_keys and two
    /etc/sudoers.d files as REMOVED. They existed. That is worse than a silent gap -
    it FABRICATES a security-relevant event, and it flatly contradicted this tool's
    own promise that "clean" never means "I could not look".
    """
    b, a = set(before or {}), set(after or {})
    blind = [str(x).rstrip("/") for x in (blind or [])]

    def unreadable(path: str) -> bool:
        return any(path == x or path.startswith(x + "/") for x in blind)

    gone = sorted(b - a)
    return {
        "modified": sorted(p for p in (b & a) if before[p] != after[p]),
        "created": sorted(a - b),
        # only paths we could actually LOOK at and did not find
        "removed": [p for p in gone if not unreadable(p)],
        # seen before, unreadable now: reported honestly as unknown
        "unreadable": [p for p in gone if unreadable(p)],
    }


def diff_keys(before: dict, after: dict) -> list:
    """Which CONFIG KEYS changed. Names only - never a value, before or after."""
    out = []
    for path in sorted(set(before or {}) | set(after or {})):
        b, a = (before or {}).get(path, {}), (after or {}).get(path, {})
        for k in sorted(set(b) | set(a)):
            if b.get(k) != a.get(k):
                verb = "changed" if (k in b and k in a) else ("added" if k in a else "removed")
                out.append(f"{k} {verb}")
    return out


def hash_group(name: str) -> dict:
    """Merkle: the group digest is the hash of its subgroup digests, so a change
    is attributed to a subgroup without rehashing anything else."""
    subs, roll = {}, hashlib.sha256()
    for sname in sorted(GROUPS[name]["subs"]):
        si = GROUPS[name]["subs"][sname]
        if not si["paths"]:
            continue
        r = hash_sub(si["paths"], si["budget"], si.get("keys", False))
        subs[sname] = r
        roll.update(f"{sname}:{r['hash']}\n".encode())
    return {"hash": roll.hexdigest()[:16], "subs": subs}


def load_baseline() -> dict:
    try:
        return json.loads(BASELINE.read_text())
    except Exception:
        return {}


def save_baseline(b: dict) -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    tmp = BASELINE.with_suffix(".tmp")
    tmp.write_text(json.dumps(b, indent=1, sort_keys=True))
    os.replace(tmp, BASELINE)   # atomic; a reader never sees a half file


def dirty_groups(against=None) -> dict:
    """Which SUBGROUPS differ. Sub-level, because 'network/dns changed' is
    actionable and 'network changed' is not.

    `against` is a SESSION snapshot taken at login. When present, the diff covers
    only what changed while that agent was logged in - which is the only thing an
    AGENT memory should ever claim. Falling back to the long-lived baseline reports
    the OS's own work as the agent's."""
    base = against if against is not None else load_baseline()
    out = {}
    for name in GROUPS:
        try:
            cur = hash_group(name)
        except Exception:
            # A group we cannot hash is UNKNOWN, never "unchanged".
            out[name] = {"since": "unknown", "subs": [("<unreadable>", 0)], "files": 0}
            continue
        prev = base.get(name, {})
        if not prev.get("hash"):
            continue                      # never baselined: not a change
        if prev["hash"] == cur["hash"]:
            continue
        changed, named = [], {}
        for sname, r in cur["subs"].items():
            pv = (prev.get("subs") or {}).get(sname, {})
            if pv.get("hash") == r["hash"]:
                continue
            d = diff_files(pv.get("f"), r.get("f"), r.get("blind"))
            d["keys"] = diff_keys(pv.get("k"), r.get("k"))
            total = len(d["modified"]) + len(d["created"]) + len(d["removed"])
            if total == 0 and d.get("unreadable"):
                # Nothing actually changed that we could see; we just lost visibility.
                # Reporting this as a change sends the next agent chasing a phantom.
                continue
            changed.append((sname, total or r["files"]))
            named[sname] = d
        # The group digest can differ purely because we lost VISIBILITY this pass.
        # Reporting that as an unrecorded change sends the next agent chasing a
        # phantom, which is the same fabrication the "removed" bug caused.
        if not changed:
            continue
        out[name] = {"since": prev.get("ts", "unknown"), "subs": changed,
                     "named": named, "files": sum(c for _, c in changed)}
    return out


def rebaseline(names=None) -> None:
    base = load_baseline()
    for name in (names or list(GROUPS)):
        try:
            r = hash_group(name)
        except Exception:
            continue
        base[name] = {**r, "ts": now()}
    save_baseline(base)


