def cmd_who(argv) -> int:
    """Who wrote this path, on the kernel's evidence. The question the diff engine can
    never answer, and the reason this layer exists."""
    if not argv:
        print("usage: woam who <path> [path...]", file=sys.stderr)
        return 2
    ok, why = audit_available()
    if not ok:
        # An honest "I cannot tell you" beats a guess dressed as an answer.
        print(f"attribution UNAVAILABLE: {why}", file=sys.stderr)
        print("  woam audit-install   (as root) sets it up", file=sys.stderr)
        return 1
    verdict, actors, events = attribution_for(argv)
    if verdict == "unwatched":
        print("NOT WATCHED. Nothing can be concluded about these paths, and absence of a")
        print("record here does NOT mean nothing happened.")
        print("  woam audit-rules   shows what would be watched")
        return 1
    if verdict == "none":
        print("watched, and no write recorded since the log begins.")
        return 0
    if verdict == "system":
        print("SYSTEM. Every recorded write came from outside a login session")
        print("(auid unset), so no agent or person did this.")
    else:
        print("AGENT/HUMAN: " + ", ".join(actors))
    for e in events[-10:]:
        who = "system" if e["system"] else f"{uid_name(e['auid'])} ses={e['ses']}"
        stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(e["ts"]))
        print(f"  {stamp}  {who:24s} {e['comm'] or '?':10s} {' '.join(e['paths'])}")
    return 0


def cmd_audit_rules(argv) -> int:
    """Print the watches, generated from GROUPS so the two cannot drift."""
    sys.stdout.write(audit_rules_text())
    return 0


def cmd_audit_status(argv) -> int:
    ok, why = audit_available()
    print(f"audit log     {AUDIT_LOG}  {'readable' if ok else 'NO - ' + why}")
    print(f"rules file    {AUDIT_RULES}  {'present' if AUDIT_RULES.exists() else 'ABSENT'}")
    watched = audit_watched_paths()
    print(f"watched paths {len(watched)}")
    auid, ses = self_login()
    if auid is None:
        print("this process  loginuid UNAVAILABLE (kernel without audit support?)")
    elif auid == AUID_UNSET:
        print("this process  auid=unset - NO login session behind it (a service, cron, or boot)")
    else:
        print(f"this process  auid={auid} ({uid_name(auid)})  ses={ses}")
    if not ok or not watched:
        # Say plainly what is lost, rather than letting a quiet report imply everything works.
        print("\nATTRIBUTION IS OFF. woam can still tell you WHAT changed; it cannot tell you")
        print("who, and it will not pretend otherwise.")
        return 1
    return 0


def cmd_audit_install(argv) -> int:
    """Write the rules and load them. Root only; says what it needs rather than half-doing it."""
    if os.geteuid() != 0:
        print("woam audit-install must run as root (it writes audit rules).", file=sys.stderr)
        return 1
    if not sh("command -v auditctl"):
        print("auditctl not found. Install the audit package first:", file=sys.stderr)
        print("  apt-get install -y auditd", file=sys.stderr)
        return 1
    try:
        AUDIT_RULES.parent.mkdir(parents=True, exist_ok=True)
        AUDIT_RULES.write_text(audit_rules_text())
        os.chmod(str(AUDIT_RULES), 0o600)
    except Exception as e:
        print(f"could not write {AUDIT_RULES}: {e}", file=sys.stderr)
        return 1
    # Load now as well as at boot. A rule that only applies after the next reboot is a
    # blind window nobody remembers to close.
    loaded, failed = 0, 0
    for line in audit_rules_text().splitlines():
        if not line.startswith("-w"):
            continue
        path = line.split()[1]
        if not Path(path).exists():
            continue                      # auditctl refuses a watch on a missing path
        r = subprocess.run(["auditctl"] + line.split(), capture_output=True, text=True)
        loaded += 1 if r.returncode == 0 else 0
        failed += 0 if r.returncode == 0 else 1
    print(f"{AUDIT_RULES} written; {loaded} watch(es) loaded"
          + (f", {failed} failed" if failed else ""))
    if failed:
        print("a failed watch means those paths have NO attribution. That is a gap, not a warning.")
    return 0


COMMANDS = {
    "status": cmd_status, "show": cmd_show, "note": cmd_note, "fix": cmd_fix,
    "gaps": cmd_gaps, "log": cmd_log, "groups": cmd_groups, "which": cmd_which,
    "seal": cmd_seal, "why": cmd_why, "session-open": cmd_session_open,
    "who": cmd_who, "audit-rules": cmd_audit_rules, "audit-status": cmd_audit_status,
    "audit-install": cmd_audit_install,
    "baseline": lambda a: (rebaseline(a or None), print("baseline recorded"), 0)[-1],
}


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        return cmd_status([])
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        print("commands: " + "  ".join(COMMANDS))
        return 0
    fn = COMMANDS.get(cmd)
    if not fn:
        print(f"unknown command '{cmd}'. try: {'  '.join(COMMANDS)}", file=sys.stderr)
        return 2
    try:
        return fn(rest)
    except Exception as e:                           # noqa: BLE001 - deliberate
        print(f"woam {cmd}: {type(e).__name__}: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    # NOTHING may ever raise out of woam. It is the audit path: a crash here means
    # an agent gets a stack trace instead of a record, concludes the tool is broken,
    # and stops using it - which loses the memory permanently, not just this once.
    # A traceback is never a useful answer to "what changed on this machine".
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except SystemExit:
        raise
    except BaseException as e:                       # noqa: BLE001 - deliberate
        # Degrade to a truthful, actionable failure. Exit 1, not 0: an error is
        # NOT a clean bill of health, and treating it as one is exactly the
        # confidently-wrong failure this tool exists to prevent.
        print(f"woam: internal error ({type(e).__name__}: {e})", file=sys.stderr)
        print("woam: could not determine this machine's state. Do NOT read this as 'clean'.",
              file=sys.stderr)
        if os.environ.get("WOAM_DEBUG"):
            import traceback; traceback.print_exc()
        sys.exit(1)
